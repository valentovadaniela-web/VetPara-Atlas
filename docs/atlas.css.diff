+/* PRIDANÉ (2026-09-19): prepínač jednotiek veľkosti (µm/mm/cm).
+   Zdieľaný komponent — vo filtri (bežná veľkosť) aj v detaile objektu
+   v quad-boxe "Veľkosť" (kompaktná varianta, .atlas-size-unit-toggle--compact). */
+.atlas-size-unit-toggle {
+    display: inline-flex;
+    border: 1px solid var(--color-secondary);
+    border-radius: var(--radius-sm);
+    overflow: hidden;
+    margin-bottom: var(--space-sm);
+}
+
+.atlas-unit-btn {
+    min-height: 36px;
+    padding: var(--space-xs) var(--space-sm);
+    border: 0;
+    background: transparent;
+    color: var(--color-secondary);
+    cursor: pointer;
+    font-size: var(--font-size-xs);
+    font-weight: 600;
+}
+
+.atlas-unit-btn + .atlas-unit-btn {
+    border-left: 1px solid var(--color-secondary);
+}
+
+.atlas-unit-btn:hover {
+    background: var(--color-surface-alt);
+}
+
+.atlas-unit-btn.active {
+    background: var(--color-secondary);
+    color: var(--color-surface);
+}
+
+.atlas-unit-btn:focus-visible {
+    outline: 3px solid var(--color-focus);
+    outline-offset: -3px;
+}
+
+.atlas-size-unit-toggle--compact {
+    margin: var(--space-xs) 0 0;
+}
+
+.atlas-size-unit-toggle--compact .atlas-unit-btn {
+    min-height: 28px;
+    padding: 2px var(--space-xs);
+    font-size: var(--fs-xs);
+}
+
+.quad-box-size {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+}
