+// Zoznam ODRÁŽOK (diagnosticSigns, differentialDiagnosis): jedna odrážka = jeden RIADOK
+// v bunke (Alt+Enter). Čiarky, bodkočiarky aj '|' vnútri odrážky sú tak povolené
+// a odrážku nerozdelia. Formátovanie píš značkami (**tučné**, _kurzíva_, __podčiarknuté__,
+// ~~prečiarknuté~~) — to isté, čo číta formatRichText() v AtlasPage.js.
+// Zalomenie riadku UVNÚTRI jednej odrážky = doslovné dva znaky \n (nie Alt+Enter).
+function parseItemListField(value) {
+    if (value === undefined || value === null || value === '') return [];
+    return String(value).split(/\r?\n/).map(s => s.trim()).filter(Boolean);
+}
+
+function serializeItemListField(arr) {
+    return (arr || []).join('\n');
+}
+
+// Voľný viacriadkový text (lifeCycle, pathology, notes, poznámky v hostNotes).
+// Excel/iné nástroje občas uložia jedno Alt+Enter ako viac znakov (napr. \r\r\n\n),
+// čo prehliadač zobrazí ako 2-3 zalomenia. Každá súvislá skupina \r/\n sa preto
+// zredukuje na JEDEN '\n'. Prázdny riadok (odstavec) zapíš doslovne ako \n\n (dva znaky + dva znaky).
+function normalizeMultiline(value) {
+    if (value === undefined || value === null) return '';
+    return String(value).replace(/[\r\n]+/g, '\n').trim();
+}
+
